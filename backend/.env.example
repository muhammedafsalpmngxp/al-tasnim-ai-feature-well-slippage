# ---------------------------------------------------------------------------
# Daily Morning Brief - backend environment TEMPLATE
# Copy to backend/.env and fill in. Never commit a filled-in .env.
# ---------------------------------------------------------------------------

# ---- Database (read-only access is sufficient) ----
DB_DRIVER=
# e.g. ODBC Driver 18 for SQL Server
DB_SERVER=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
DB_CONNECT_TIMEOUT=15
DB_QUERY_TIMEOUT=60
# Code page used to decode non-Unicode (varchar) columns such as ref.uom.uom_code,
# which stores values like m2 / m3 as single-byte characters.
DB_ANSI_CODEPAGE=cp1252

# ---- API ----
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=INFO
# Comma-separated origins allowed to call this API (the React dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Dashboard behaviour (configurable, never hardcoded in React) ----
# At or below this many logical daily tasks the dashboard shows individual
# task cards instead of grouped summaries.
DETAIL_VIEW_TASK_THRESHOLD=25
# Seconds a resolved day stays cached in the API process. 0 disables caching.
DAILY_CACHE_TTL_SECONDS=60
# Maximum tasks included in the evidence payload sent to the LLM.
EXPLAIN_MAX_WELLS=40
# Maximum successful AI explanations kept in memory (across all dates
# combined) so pressing "AI summary" again for unchanged data reuses the
# earlier answer instead of spending new LLM tokens. Correctness never
# depends on this number -- it only bounds memory in a long-running process.
EXPLAIN_CACHE_MAX_ENTRIES=500
# Where that cache is saved to disk so it survives a restart -- so the very
# first request after restarting still benefits, not just the second one
# within a single run. Relative to backend/.
EXPLAIN_CACHE_FILE=.cache/explain_cache.json
# Days ahead of a well's pegging / FLAF / rig-on / rig-off deadline at which it
# starts showing up as an "upcoming" priority milestone alert.
MILESTONE_PRIORITY_WINDOW_DAYS=7
# Maximum already-overdue milestones returned in the capped detail list (the
# true total is always reported separately as overdue_count).
MILESTONE_OVERDUE_DISPLAY_LIMIT=20

# ---- LLM (explanation layer only) ----
# provider is "openai" or "groq" -- both speak the same chat-completions
# protocol, so switching is just these values, never a code change.
LLM_PROVIDER=openai
LLM_API_KEY=
# e.g. gpt-4o-mini for openai, or openai/gpt-oss-120b for groq
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=900
LLM_TEMPERATURE=0.2

# ---- Authoritative usage sync (llm_usage_tracker.py, project root) ----
# The per-call expense log only ever sees calls made through this running
# application -- not the test suite (which disables it on purpose), and not
# anything else spending tokens on the same key. `python llm_usage_tracker.py
# sync` pulls what OpenAI actually billed into the same workbook.
#
# This must be an ADMIN key (Organization -> Admin keys, starts sk-admin-),
# NOT the LLM_API_KEY above: organisation usage and cost are admin-scoped
# endpoints and refuse an ordinary project key. Leave blank to skip the sync.
OPENAI_ADMIN_KEY=
# How many days back each sync pulls, unless --days says otherwise.
OPENAI_USAGE_DAYS=30
# Comma-separated project ids to limit the sync to; blank means the whole
# organisation.
OPENAI_USAGE_PROJECT_IDS=
# Where the organisation usage/cost endpoints live.
OPENAI_USAGE_BASE_URL=https://api.openai.com/v1

# ---- Development only ----
# Must stay false. Never substitute mock data for production data.
USE_MOCK_DATA=false
